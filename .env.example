# Clerk Authentication
# Get your keys from https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# API Base URL
# Default: https://api.tinfoil.sh
NEXT_PUBLIC_API_BASE_URL=https://api.tinfoil.sh

# Local development mode
# When true, bypasses TinfoilAI client and connects to a local router on localhost:8090
NEXT_PUBLIC_DEV=false
# Only necessary if local dev mode is on.
NEXT_PUBLIC_DEV_API_KEY=your-tinfoil-api-key-here
# Firebase Cloud Messaging (web push notifications for finished chat streams)
# All values are public identifiers from the Firebase console (Project
# settings > General > Your apps). Push is disabled when any value is unset.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web Push certificate key pair (Project settings > Cloud Messaging)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
